<Window x:Class="SeqxcToolset.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seqxc Toolset" Height="760" Width="1200"
        Icon="app.ico"
        Background="{StaticResource BgAppBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear All Changes" Margin="0,0,8,0"
                            Click="ClearAllChanges_Click"/>
                    <Button Content="Save All Changes..." Style="{StaticResource PrimaryButton}"
                            Click="SaveAllChanges_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open .seqxc..." Style="{StaticResource PrimaryButton}"
                            Click="OpenFile_Click" Width="130"/>
                    <TextBlock x:Name="FilePathText" Text="No file loaded"
                               Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Margin="10,5"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Border>

        <!-- Task sidebar -->
        <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10">
                <TextBlock Text="TASKS" Margin="14,0,0,8" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="TaskList_SelectionChanged"
                         DisplayMemberPath="TaskName"/>
            </StackPanel>
        </Border>

        <!-- Active task view -->
        <Border Background="{StaticResource BgAppBrush}">
            <ContentControl x:Name="TaskHost" Margin="16"/>
        </Border>

    </DockPanel>
</Window>
