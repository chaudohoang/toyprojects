<UserControl x:Class="SeqxcToolset.Tasks.LuminanceScaleTask.LuminanceScaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Disables (and visually dims) the New cells for rows whose Analysis
             type doesn't carry Luminance Scale at all — nothing there to apply to. -->
        <Style x:Key="NewCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DataCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLuminanceFields}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="#FFEDEDED"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Controls live in a bar along the bottom rather than a side panel, so the grid
         gets the full window width. The bar must be declared before the DataGrid: a
         DockPanel fills with its LAST child, so the grid has to come last. -->
    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Luminance Scale" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <CheckBox x:Name="ShowAllCheck" Content="Show all items (incl. unselected)"
                      Margin="20,0,0,0" VerticalAlignment="Center"
                      Checked="ShowAllCheck_Changed" Unchecked="ShowAllCheck_Changed"/>
            <TextBlock Text="&#9432;" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"
                       Cursor="Help" Foreground="{StaticResource TextMutedBrush}"
                       ToolTip="LuminanceScaleRed/Green/Blue live on the SequenceItem's own Analysis element, not in PatternSetup — only some Analysis types have them (blank Red/Green/Blue = not applicable to that step, and an import skips those).&#10;&#10;&quot;New (all)&quot; fills Red/Green/Blue at once, the common case where they match, and what an Excel import writes."/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Excel:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ExcelFileLabel}" ToolTip="{Binding ExcelFilePath}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MaxWidth="620" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <Button Content="Choose file..." Margin="14,0,0,0" MinWidth="110"
                            Command="{Binding ImportFromExcelCommand}"
                            ToolTip="Pick a workbook, then the sheet, the pattern name column and the luminance scale column"/>
                    <Button Content="Choose columns" Margin="8,0,0,0" MinWidth="130"
                            Command="{Binding PickColumnsCommand}"
                            ToolTip="Pick the sheet and columns again from the workbook named here — no file dialog"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear New Values" Margin="0,0,8,0" MinWidth="130"
                            Command="{Binding ClearNewValuesCommand}"/>
                    <Button Content="Save Changes..." Style="{StaticResource PrimaryButton}" MinWidth="130"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>

                <!-- Fills what's left; an import summary can be long, so it trims and
                     carries the full text as its tooltip. -->
                <TextBlock Text="{Binding ImportSummary}" ToolTip="{Binding ImportSummary}"
                           VerticalAlignment="Center" Margin="16,0,16,0" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionUnit="Cell" SelectionMode="Extended"
                  Background="{StaticResource BgPanelBrush}" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CellStyle="{StaticResource DataCellStyle}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DirtyBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="35" IsReadOnly="True"/>
                <DataGridTextColumn Header="Pattern Setup Name" Binding="{Binding PatternSetupName}" Width="Auto" MinWidth="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Analysis" Binding="{Binding AnalysisType}" Width="Auto" MinWidth="140" IsReadOnly="True"/>

                <DataGridTextColumn Header="Red" Binding="{Binding Red}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewRed, UpdateSourceTrigger=PropertyChanged}" Width="70" CellStyle="{StaticResource NewCellStyle}"/>

                <DataGridTextColumn Header="Green" Binding="{Binding Green}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewGreen, UpdateSourceTrigger=PropertyChanged}" Width="70" CellStyle="{StaticResource NewCellStyle}"/>

                <DataGridTextColumn Header="Blue" Binding="{Binding Blue}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewBlue, UpdateSourceTrigger=PropertyChanged}" Width="70" CellStyle="{StaticResource NewCellStyle}"/>

                <DataGridTextColumn Header="New (all)" Binding="{Binding NewAll, UpdateSourceTrigger=PropertyChanged}" Width="80" CellStyle="{StaticResource NewCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
