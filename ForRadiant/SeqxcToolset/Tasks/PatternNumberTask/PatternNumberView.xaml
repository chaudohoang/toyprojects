<UserControl x:Class="SeqxcToolset.Tasks.PatternNumberTask.PatternNumberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Left: grid of sequence items -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Pattern Numbers" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowAllCheck" Content="Show all items (incl. unselected)"
                          Margin="20,0,0,0" VerticalAlignment="Center"
                          Checked="ShowAllCheck_Changed" Unchecked="ShowAllCheck_Changed"/>
            </StackPanel>

            <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionUnit="Cell" SelectionMode="Extended"
                      Background="{StaticResource BgPanelBrush}" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DirtyBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlias}" Value="True">
                                <Setter Property="ToolTip" Value="Alias — resolved via another pattern"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="35" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Pattern Setup Name" Binding="{Binding PatternSetupName}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Analysis" Binding="{Binding AnalysisType}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Resolved Via" Binding="{Binding ResolvedTerminalName}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Current #" Binding="{Binding CurrentPatternNumber}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="New #" Binding="{Binding NewPatternNumber, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: excel import + actions -->
        <Border Grid.Column="1" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Import from Excel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="0,0,0,8">
                    Copy a 3-column range from Excel (Name / As is / To be — header row optional)
                    and paste it below, or type rows directly as
                    "Name&lt;TAB&gt;AsIs&lt;TAB&gt;ToBe".
                </TextBlock>
                <TextBox Grid.Row="2" x:Name="PasteBox" MinHeight="120" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                         Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="3" Content="Parse &amp; Match" Margin="0,8,0,0" Command="{Binding ParseImportCommand}"/>
                <TextBlock Grid.Row="4" Text="{Binding ImportSummary}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <Separator Grid.Row="5" Margin="0,14"/>

                <StackPanel Grid.Row="6">
                    <Button Content="Save Changes..." Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Clear New Values" Margin="0,8,0,0"
                            Command="{Binding ClearNewValuesCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
