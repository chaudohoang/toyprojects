<Window x:Class="SeqxcToolset.Tasks.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from Excel" Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgAppBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">

        <TextBlock x:Name="FileText" DockPanel.Dock="Top" TextWrapping="Wrap"
                   Margin="0,0,0,10" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Width="90" IsCancel="True"/>
            <Button x:Name="ImportButton" Content="Import" Style="{StaticResource PrimaryButton}"
                    Width="110" Click="Import_Click" IsDefault="True"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                   Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>

        <!-- Pickers -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sheet" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SheetCombo" Margin="0,4"
                          SelectionChanged="SheetCombo_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Header row" VerticalAlignment="Center" Margin="0,4"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBox x:Name="HeaderRowBox" Width="60" TextChanged="HeaderRowBox_TextChanged"/>
                    <TextBlock x:Name="HeaderHintText" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pattern name column"
                           VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="NameCombo" Margin="0,4"
                          DisplayMemberPath="Display" SelectionChanged="Column_SelectionChanged"/>

                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="ValueLabel" Text="Value column"
                           VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ValueCombo" Margin="0,4"
                          DisplayMemberPath="Display" SelectionChanged="Column_SelectionChanged"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="&quot;As is&quot; column (optional)"
                           VerticalAlignment="Center" Margin="0,4"
                           ToolTip="Compared against the file and reported on mismatch — never blocks the import"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AsIsCombo" Margin="0,4"
                          DisplayMemberPath="Display" SelectionChanged="Column_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Preview -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" Background="{StaticResource BgPanelBrush}"
                      RowHeaderWidth="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                    <DataGridTextColumn Header="Pattern" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="As is" Binding="{Binding AsIs}" Width="120"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ToBe}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

    </DockPanel>
</Window>
