<UserControl x:Class="SeqxcToolset.Tasks.ExposureTimeTask.ExposureTimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Controls live in a bar along the bottom rather than a side panel, so the grid
         gets the full window width. The bar must be declared before the DataGrid: a
         DockPanel fills with its LAST child, so the grid has to come last. -->
    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Exposure Time" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <CheckBox x:Name="ShowAllCheck" Content="Show all items (incl. unselected)"
                      Margin="20,0,0,0" VerticalAlignment="Center"
                      Checked="ShowAllCheck_Changed" Unchecked="ShowAllCheck_Changed"/>
            <TextBlock Text="&#9432;" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"
                       Cursor="Help" Foreground="{StaticResource TextMutedBrush}"
                       ToolTip="&quot;New Exp (all)&quot; fills Y/X/Z exposure at once — the common case where all three match, and what an Excel import writes.&#10;&#10;Click a &quot;New&quot; checkbox to override Capture (cycles checked → unchecked → back to &quot;no change&quot;).&#10;&#10;Per-channel exposure cells still work individually if one needs to differ."/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Excel:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ExcelFileLabel}" ToolTip="{Binding ExcelFilePath}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MaxWidth="620" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <Button Content="Choose file..." Margin="14,0,0,0" MinWidth="110"
                            Command="{Binding ImportFromExcelCommand}"
                            ToolTip="Pick a workbook, then the sheet, the pattern name column and the exposure time column"/>
                    <Button Content="Choose columns" Margin="8,0,0,0" MinWidth="130"
                            Command="{Binding PickColumnsCommand}"
                            ToolTip="Pick the sheet and columns again from the workbook named here — no file dialog"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear New Values" Margin="0,0,8,0" MinWidth="130"
                            Command="{Binding ClearNewValuesCommand}"/>
                    <Button Content="Save Changes..." Style="{StaticResource PrimaryButton}" MinWidth="130"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>

                <!-- Fills what's left; an import summary can be long, so it trims and
                     carries the full text as its tooltip. -->
                <TextBlock Text="{Binding ImportSummary}" ToolTip="{Binding ImportSummary}"
                           VerticalAlignment="Center" Margin="16,0,16,0" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </DockPanel>
        </Border>

        <!-- CanUserDeleteRows="False": Delete is handled by DataGridEditHelper to
             clear the selected cells. Left at its default of true, the DataGrid would
             also try to remove the row itself, which would drop a step out of the view. -->
        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="Cell" SelectionMode="Extended"
                  Background="{StaticResource BgPanelBrush}" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CellStyle="{StaticResource DataCellStyle}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DirtyBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="35" IsReadOnly="True"/>
                <DataGridTextColumn Header="Pattern Setup Name" Binding="{Binding PatternSetupName}" Width="Auto" MinWidth="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Analysis" Binding="{Binding AnalysisType}" Width="Auto" MinWidth="140" IsReadOnly="True"/>

                <DataGridCheckBoxColumn Header="Y (Green)" Binding="{Binding YCapture}" Width="70" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="New" Binding="{Binding NewYCapture, UpdateSourceTrigger=PropertyChanged}" Width="45" IsThreeState="True"/>
                <DataGridTextColumn Header="Y Exp (ms)" Binding="{Binding YExposure}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewYExposure, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                <DataGridCheckBoxColumn Header="X (Red)" Binding="{Binding XCapture}" Width="70" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="New" Binding="{Binding NewXCapture, UpdateSourceTrigger=PropertyChanged}" Width="45" IsThreeState="True"/>
                <DataGridTextColumn Header="X Exp (ms)" Binding="{Binding XExposure}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewXExposure, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                <DataGridCheckBoxColumn Header="Z (Blue)" Binding="{Binding ZCapture}" Width="70" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="New" Binding="{Binding NewZCapture, UpdateSourceTrigger=PropertyChanged}" Width="45" IsThreeState="True"/>
                <DataGridTextColumn Header="Z Exp (ms)" Binding="{Binding ZExposure}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewZExposure, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                <DataGridTextColumn Header="New Exp (all)" Binding="{Binding NewExpAll, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
