<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled only for NotifyIcon (the system tray icon); WPF has none built in -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FtpUpload</RootNamespace>
    <AssemblyName>FtpUpload</AssemblyName>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StartupObject>FtpUpload.Program</StartupObject>
    <!-- exe icon shown in taskbar, alt-tab, and File Explorer -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <!-- WinSCP engine. The NuGet package supplies the .NET-compatible (netstandard2.0) WinSCPnet.dll
         AND WinSCP.exe (copied next to the app). The loose net40 WinSCPnet.dll is NOT usable from
         .NET 8 — its named-event/security APIs are binary-incompatible (MissingMethodException on
         Session.Open) — so the package build is required. -->
    <PackageReference Include="WinSCP" Version="5.21.2" />
  </ItemGroup>

</Project>
