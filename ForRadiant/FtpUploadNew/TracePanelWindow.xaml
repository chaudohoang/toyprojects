<Window x:Class="FtpUpload.TracePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trace Panel" Height="620" Width="940"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Trace a panel through every log"
                       FontSize="15" FontWeight="Bold" Foreground="#14203C"/>
            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="#6B7386"
                       Text="Jobs file, upload history, NG recovery, finalize markers, and what the server actually confirmed."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <TextBlock Text="Panel ID" FontSize="12" FontWeight="SemiBold" Foreground="#3A4256"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- embedded clear, same pattern as the strips: the x sits inside the box and only
                 appears when there is text, so the box never changes width -->
            <Border Background="White" CornerRadius="4" BorderBrush="#ABADB3" BorderThickness="1"
                    Padding="6,0" Height="28" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="PidBox" Width="240" BorderThickness="0" FontSize="13"
                             VerticalContentAlignment="Center" Background="Transparent"
                             KeyDown="PidBox_KeyDown" TextChanged="PidBox_TextChanged"/>
                    <Button x:Name="PidClear" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            FontSize="9" Width="16" Height="16" Padding="0" Margin="2,0,0,0"
                            VerticalAlignment="Center" Cursor="Hand" Visibility="Hidden"
                            Background="Transparent" BorderThickness="0" Foreground="#8A97BD"
                            ToolTip="Clear" Click="PidClear_Click"/>
                </StackPanel>
            </Border>
            <Button x:Name="SearchBtn" Content="Search" Width="90" Height="28" Margin="8,0,0,0"
                    Cursor="Hand" FontWeight="SemiBold" Click="Search_Click"
                    Background="#4D8CFF" BorderBrush="#3D74D8" BorderThickness="1" Foreground="White"/>
            <Button x:Name="CopyBtn" Content="Copy" Width="72" Height="28" Margin="16,0,0,0"
                    Cursor="Hand" Click="Copy_Click"
                    Background="White" BorderBrush="#C9DAF8" BorderThickness="1" Foreground="#3A4256"
                    ToolTip="Copy the whole report to the clipboard"/>
            <Button x:Name="SaveBtn" Content="Save Report" Width="100" Height="28" Margin="8,0,0,0"
                    Cursor="Hand" Click="Save_Click"
                    Background="White" BorderBrush="#C9DAF8" BorderThickness="1" Foreground="#3A4256"
                    ToolTip="Save the report to a file you choose"/>
            <Button x:Name="OpenBtn" Content="Open as file" Width="100" Height="28" Margin="8,0,0,0"
                    Cursor="Hand" Click="Open_Click"
                    Background="White" BorderBrush="#C9DAF8" BorderThickness="1" Foreground="#3A4256"
                    ToolTip="Write the report to a temporary file and open it in your text editor"/>
            <CheckBox x:Name="AutoRefresh" Content="Auto-refresh" Margin="16,0,0,0"
                      VerticalAlignment="Center" FontSize="11.5" Foreground="#3A4256"
                      Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"
                      ToolTip="Re-run the trace every few seconds. A trace is a snapshot: a file can read 'not uploaded' and land moments later while NG is still working."/>
        </StackPanel>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#ECEFF5" BorderThickness="1">
            <TabItem Header="Report">
                <TextBox x:Name="ReportBox" IsReadOnly="True" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="Transparent"
                         Text="Type a panel ID and press Search (or Enter)."/>
            </TabItem>
            <!-- The evidence behind the report: the exact lines, unedited. When the summary and
                 reality disagree this is the tab that settles it. -->
            <TabItem Header="Raw log lines">
                <TextBox x:Name="RawBox" IsReadOnly="True" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11.5" Padding="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="Transparent"
                         Text="The verbatim lines from every log: jobs file, rawlog, ng-retry, oplog, the manifests, the .midfail record, and the WinSCP session dialogue."/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" Foreground="#8891A3"
                   Text="Partial panel IDs are fine - type enough to be unique. Searches every day still held in the log folder, newest first."/>
    </Grid>
</Window>
