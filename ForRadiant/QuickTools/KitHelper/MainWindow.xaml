<Window x:Class="KitHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kit Helper" Width="940" Height="920"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource Fg}">
    <Border CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- ======================================================== header (drag to move) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" Click="Hide_Click"
                        ToolTip="Hide (Esc). The icon stays; right-click it to exit."/>
                <Ellipse Width="14" Height="14" Fill="{StaticResource Brand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Kit Helper" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtVersion" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,1,0,0"/>
            </DockPanel>

            <!-- ======================================================== kit folder + TrueTest install -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Kit folder" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboSource" Grid.Column="1" IsEditable="True"
                          KeyDown="CboSource_KeyDown" LostKeyboardFocus="CboSource_LostFocus" DropDownClosed="CboSource_DropDownClosed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Browse…" Click="Browse_Click"/>
                    <Button Content="Open" Click="Open_Click" ToolTip="Open the kit folder in Explorer"/>
                    <Button Content="Refresh" Click="Refresh_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtSourceInfo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="2,3,0,8"/>

                <TextBlock Grid.Row="2" Text="TrueTest install" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboInstall" Grid.Row="2" Grid.Column="1" SelectionChanged="CboInstall_SelectionChanged"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Rescan" Click="Rescan_Click"/>
                    <Button Content="Kits from old TrueTest…" Click="Migrate_Click"
                            ToolTip="After installing a new TrueTest: copy the kit folders from the old (renamed) install"/>
                    <Button x:Name="BtnAdmin" Content="Run as admin" Click="Admin_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtRunning" Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" Margin="2,3,0,0"/>
            </Grid>

            <!-- ======================================================== tools -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="60*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Copy kit folder to TrueTest" Style="{StaticResource SectionTitle}"/>
                            <StackPanel x:Name="CopyButtons"/>
                            <TextBlock x:Name="TxtSuggest" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkCloseTT" Content="Close TrueTest before copying (offer restart after)" Margin="0,2,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Text="POCB skips *.tif, *.csv and LGD_VNTT.ini. Other targets copy every file in the folder."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Other" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="BtnUnblock" Content="Unblock kit folder" Style="{StaticResource ActionButton}" Click="Unblock_Click"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Removes the &quot;downloaded from internet&quot; mark, including files in subfolders."/>
                            <Button x:Name="BtnExplorer" Style="{StaticResource ActionButton}" Click="Explorer_Click" Margin="0,4,0,6"/>
                            <TextBlock x:Name="TxtExplorerHint" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="TxtInstalled" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock x:Name="TxtVignettingTitle" Style="{StaticResource SectionTitle}"/>
                            <ListView x:Name="LvIni" Height="120">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="INI file" Width="380">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{Binding Brush}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Value" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Value}" Foreground="{Binding Brush}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnVigOn" Content="Set ON (1)" Margin="0" Click="VigOn_Click"/>
                                <Button x:Name="BtnVigOff" Content="Set OFF (0)" Click="VigOff_Click"/>
                                <CheckBox x:Name="ChkDx" Content="Include DX ini" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Run test  (RunTestOmit / RunTestPUC input file)" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Input .txt" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboRunInput" Grid.Column="1" IsEditable="True"
                                          SelectionChanged="CboRunInput_SelectionChanged" LostKeyboardFocus="CboRunInput_LostFocus"/>
                                <Button Grid.Column="2" Content="Browse…" Click="BrowseRunInput_Click"/>

                                <TextBlock Grid.Row="1" Text="Mode" Style="{StaticResource FieldLabel}" Margin="0,8,10,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="RbOmit" Content="Omit" IsChecked="True"/>
                                    <RadioButton x:Name="RbPuc" Content="PUC" Checked="RunMode_Changed" Unchecked="RunMode_Changed"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"
                                               Text="PUC runs in the kit folder, outputs to …\Test\"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Working dir" Style="{StaticResource FieldLabel}" Margin="0,8,10,0"/>
                                <ComboBox x:Name="CboWorkDir" Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="0,8,0,0"/>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnRun" Content="Run" Style="{StaticResource PrimaryButton}" Margin="0" MinWidth="80" Click="Run_Click"/>
                                    <Button x:Name="BtnStop" Content="Stop" MinWidth="70" IsEnabled="False" Click="Stop_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ======================================================== log -->
            <Border Grid.Row="3" Style="{StaticResource Section}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy" Style="{StaticResource ChromeButton}" Click="CopyLog_Click"/>
                            <Button Content="Clear" Style="{StaticResource ChromeButton}" Click="ClearLog_Click"/>
                        </StackPanel>
                        <TextBlock Text="Log" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <ListBox x:Name="LstLog" Margin="0,6,0,0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
                             ItemContainerStyle="{StaticResource LogItem}" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
