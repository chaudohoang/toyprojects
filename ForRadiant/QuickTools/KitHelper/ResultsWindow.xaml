<Window x:Class="KitHelper.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kit Helper results" Width="780" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource Fg}">
    <!-- Not modal: every copy result lands here as a tab, newest selected, and the panel stays
         usable for the next action. One window for all results (ResultsWindow.Add). -->
    <Border CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <DockPanel Margin="14,8,14,6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" Click="CloseAll_Click"
                        ToolTip="Close all results"/>
                <TextBlock Text="Copy results" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCount" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- one row of fixed-width tabs, newest last; when they don't fit, the row scrolls
                 sideways (‹ › and the mouse wheel), like browser tabs -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                <Button x:Name="BtnLeft" DockPanel.Dock="Left" Content="‹" Style="{StaticResource ChromeButton}" FontSize="15"
                        Padding="6,0" Margin="0,0,4,6" Click="ScrollLeft_Click" Visibility="Collapsed" ToolTip="Earlier results"/>
                <Button x:Name="BtnRight" DockPanel.Dock="Right" Content="›" Style="{StaticResource ChromeButton}" FontSize="15"
                        Padding="6,0" Margin="4,0,0,6" Click="ScrollRight_Click" Visibility="Collapsed" ToolTip="Later results"/>
                <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroller_PreviewMouseWheel" ScrollChanged="TabScroller_ScrollChanged">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}" Margin="0,0,0,2"/>
            <ContentControl x:Name="Body" Focusable="False"/>
        </DockPanel>
    </Border>
</Window>
