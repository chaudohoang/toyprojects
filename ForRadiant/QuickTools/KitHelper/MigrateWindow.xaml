<Window x:Class="KitHelper.MigrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy kits from an old TrueTest" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource Fg}">
    <Border CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="16,10,16,14">
            <DockPanel Margin="0,0,0,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" Click="Cancel_Click"/>
                <Ellipse Width="14" Height="14" Fill="{StaticResource Brand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Copy kits from an old TrueTest" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Text="After installing a new TrueTest, copy the kit folders already deployed in the old (renamed) install into it. Same-name files in the new install are overwritten."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="To (new install)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboTo" Grid.Column="1" SelectionChanged="CboTo_SelectionChanged"/>
                <TextBlock Text="From (old install)" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,10,10,0"/>
                <ComboBox x:Name="CboFrom" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" SelectionChanged="CboFrom_SelectionChanged"/>
                <TextBlock x:Name="TxtFromHint" Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="2,3,0,0"/>
            </Grid>

            <Border Style="{StaticResource Section}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-4,0,0">
                            <Button Content="Select all" Style="{StaticResource ChromeButton}" Click="SelectAll_Click"/>
                            <Button Content="Unselect all" Style="{StaticResource ChromeButton}" Click="UnselectAll_Click"/>
                        </StackPanel>
                        <TextBlock Text="Folders to copy" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <StackPanel x:Name="Folders"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtProblem" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,2,0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="80" Click="Cancel_Click"/>
                <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="8,0,0,0" Click="Copy_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
