<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48, not net8 like CharlieTheSlave: line PCs run it with nothing to install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for FolderBrowserDialog; WPF on net48 has no folder picker. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>KitHelper</RootNamespace>
    <AssemblyName>Kit Helper</AssemblyName>
    <StartupObject>KitHelper.Program</StartupObject>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Bump on each release. Copies compare (Version, build time) to decide which is newer:
         see BuildInfo in InstalledCopy.cs. -->
    <Version>1.4.3</Version>
    <!-- Build time rides in the product version ("1.4.0+20261118104512") so another copy's
         stamp can be read with FileVersionInfo, without loading that exe. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(Version)+$([System.DateTime]::Now.ToString("yyyyMMddHHmmss"))</InformationalVersion>
  </PropertyGroup>
</Project>
