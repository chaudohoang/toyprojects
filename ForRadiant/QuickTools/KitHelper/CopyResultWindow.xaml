<Window x:Class="KitHelper.CopyResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy result" Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource Fg}">
    <!-- Frame / HeaderBand / BadgeBox are coloured per state by SetMood (confirm amber, done green, errors red). -->
    <Border x:Name="Frame" CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <DockPanel Margin="16,10,16,14">
            <!-- header (drag to move) -->
            <Border x:Name="HeaderBand" DockPanel.Dock="Top" CornerRadius="8" Padding="10,6,4,6" Margin="-6,0,-6,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel Background="Transparent">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click"/>
                    <Border x:Name="BadgeBox" CornerRadius="4" Padding="7,1,7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBadge" FontSize="11" FontWeight="Bold" Foreground="#FF14161C"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- counts: one coloured run per status -->
            <TextBlock x:Name="TxtSummary" DockPanel.Dock="Top" FontSize="13.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtWhere" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"/>

            <!-- backup -->
            <DockPanel x:Name="PnlBackup" DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="BtnOpenBackup" DockPanel.Dock="Right" Content="Open backup" Click="OpenBackup_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtBackup" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <!-- Confirmation only, when INIs with the vignetting key are being copied. -->
            <Border x:Name="PnlVignetting" DockPanel.Dock="Top" Style="{StaticResource Section}" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtVignetting" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbVigKeep" Content="Keep as is" IsChecked="True"/>
                        <RadioButton x:Name="RbVigOn" Content="Set ON (1)" Margin="16,0,0,0"/>
                        <RadioButton x:Name="RbVigOff" Content="Set OFF (0)" Margin="16,0,0,0"/>
                        <CheckBox x:Name="ChkVigDx" Content="Include DX ini" Margin="28,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Applied to the copied files after the copy; the kit itself is not changed."/>
                </StackPanel>
            </Border>

            <!-- footer -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnSelectAll" Content="Select all" Click="SelectAll_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnSelectNone" Content="Select none" Click="SelectNone_Click" Visibility="Collapsed" Margin="6,0,24,0"/>
                <Button x:Name="BtnCopyText" Content="Copy as text" Click="CopyText_Click"/>
                <!-- Preview (confirmation): Cancel / OK, no Copy as text. Result: Copy as text / Close. -->
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Click="Close_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnPrimary" Content="Close" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="Primary_Click" IsDefault="True"/>
            </StackPanel>

            <!-- one block per destination folder -->
            <Border Style="{StaticResource Section}" Margin="0">
                <ScrollViewer x:Name="Scroller" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Groups"/>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
