<UserControl x:Class="RemoteToolsTabbed.ComputersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RemoteToolsTabbed">
    <UserControl.Resources>
        <!-- The inside of a list's header band. Shared by the real bands in the grid and by
             the pinned copy that stands in for one once it has scrolled out of sight, so the
             two cannot drift apart. It lives here, not in App.xaml, because the handlers have
             to resolve against this view. The DataContext is the group's CollectionViewGroup. -->
        <DataTemplate x:Key="GroupBandContent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource GroupChevron}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ItemCount}" Margin="6,0,0,0"
                               Foreground="{StaticResource InkSoft}"/>
                </StackPanel>

                <!-- hidden on All.csv: the default list is never removable -->
                <Button Grid.Column="2" VerticalAlignment="Center"
                        ToolTip="Unload this list. The CSV file itself is not deleted."
                        Click="RemoveListHeader_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
                            <Setter Property="Margin" Value="4,0,6,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Name.IsDefault}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,9,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="PingRow" Height="0" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and the two icon buttons. They live here rather than in the window around
             the list, so that they come with it: slid out over a session the list is hosted by
             a different window, and a header left behind took the machine count and the viewer
             options button with it. -->
        <Grid Grid.Row="0" Margin="0,0,0,9">
            <TextBlock x:Name="Title" Text="COMPUTERS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnViewerOptions" Content="&#x2699;" FontSize="13"
                        Style="{StaticResource IconButton}" Click="ViewerOptions_Click"
                        ToolTip="Viewer options - set them once, every session uses them"/>
                <!-- Only while the list is a column of the main window; slid out it has its
                     own Dock button, and there is nothing to collapse into. Labelled rather
                     than a glyph, to read as the pair of that Dock button. -->
                <Button x:Name="BtnCollapse" Content="Hide" Style="{StaticResource ToolButton}"
                        Height="22" FontSize="11" Padding="10,0" Margin="6,0,0,0"
                        ToolTip="Hide the machine list (Ctrl+B)" Click="Collapse_Click"/>
            </StackPanel>
        </Grid>

        <!-- search -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Height="28" VerticalContentAlignment="Center" Padding="7,0"
                     BorderBrush="{StaticResource ChromeBorder}"
                     TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
            <TextBlock IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoft}" Text="Search  (Ctrl+F)">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="1" Content="&#x2715;" Width="28" Height="28" Margin="6,0,0,0"
                    Style="{StaticResource ToolButton}" Padding="0" ToolTip="Clear the filter"
                    Click="ClearSearch_Click"/>
        </Grid>

        <Grid x:Name="GridHost" Grid.Row="2">
        <!-- Machines, grouped under the CSV each row came from. A grouped DataGrid stops
             virtualizing unless it is told not to, and realising every row of every list at
             once costs layout, memory and - the visible one - seconds of delay for anything
             that reads the automation tree. -->
        <!-- Horizontal scrolling off: two star columns are defined to fit, so there is never
             anything to scroll to. Left on, the grid keeps the pixel widths it last measured
             and a narrower sidebar leaves them overflowing - a scrollbar under rows that all
             fit. Disabled makes it measure against the viewport it actually has. -->
        <DataGrid x:Name="Grid" HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  CanUserAddRows="False"
                  MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown"
                  SelectionChanged="Grid_SelectionChanged"
                  Loaded="Grid_Loaded" SizeChanged="Grid_SizeChanged"
                  ScrollViewer.ScrollChanged="Grid_ScrollChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PC" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="IP" Binding="{Binding Address}" Width="3*"/>
            </DataGrid.Columns>

            <!-- One band per loaded CSV: click it to fold the list away, the x unloads it.
                 Everything hangs off Name - the MachineList the group was keyed on - so the
                 open/closed state outlives the group header that the next refresh throws away. -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            <!-- The whole band is the toggle, handled on the Border itself:
                                                 a ButtonBase placed here never sees the mouse at all, while a
                                                 plain Border in the same spot does (the x below proves it). -->
                                            <Border Style="{StaticResource GroupBand}"
                                                    ToolTip="{Binding Name.Path}"
                                                    MouseLeftButtonUp="GroupHeader_Click">
                                                <ContentPresenter Content="{Binding}"
                                                                  ContentTemplate="{StaticResource GroupBandContent}"/>
                                            </Border>
                                            <ItemsPresenter x:Name="Rows"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name.IsExpanded}" Value="False">
                                                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>

        <!-- Stands in for the band of whichever list is under the top of the viewport, once
             that band itself has scrolled up out of sight. Placed and sized from the column
             headers at run time, so it lines up whatever the sidebar's width. -->
        <Border x:Name="PinnedBand" Style="{StaticResource GroupBand}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                ToolTip="{Binding Name.Path}" MouseLeftButtonUp="GroupHeader_Click">
            <ContentPresenter Content="{Binding}"
                              ContentTemplate="{StaticResource GroupBandContent}"/>
        </Border>
        </Grid>

        <GridSplitter x:Name="PingSplitter" Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                      Background="Transparent" Visibility="Collapsed"/>

        <!-- ping output -->
        <Border Grid.Row="4" Background="{StaticResource SessionBackdrop}" CornerRadius="3">
            <ScrollViewer x:Name="PingScroller" VerticalScrollBarVisibility="Auto" Padding="8,6">
                <ItemsControl x:Name="PingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- actions -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <Button x:Name="BtnConnect" Content="Remote Control" Style="{StaticResource PrimaryButton}"
                    Height="32" Margin="0,0,0,6" Click="Connect_Click"/>
            <UniformGrid Columns="3">
                <Button Content="File Share" Style="{StaticResource ToolButton}" Padding="0" Click="FileShare_Click"/>
                <Button x:Name="BtnPing" Content="Ping" Style="{StaticResource ToolButton}" Padding="0" Click="Ping_Click"/>
                <Button Content="Save Lists" Style="{StaticResource ToolButton}" Padding="0" Margin="0"
                        ToolTip="Write every loaded list back to its own CSV"
                        Click="SaveList_Click"/>
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Content="&#x002B;  Add machine" Style="{StaticResource ToolButton}" Padding="0"
                        ToolTip="Add an empty row to the selected list, ready to type into"
                        Click="AddMachine_Click"/>
                <Button Content="&#x002B;  Add list" Style="{StaticResource ToolButton}" Padding="0" Margin="0"
                        ToolTip="Load another CSV into the list - it is remembered for next time"
                        Click="AddList_Click"/>
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Content="Expand all" Style="{StaticResource ToolButton}" Padding="0"
                        ToolTip="Open every list" Click="ExpandAll_Click"/>
                <Button Content="Collapse all" Style="{StaticResource ToolButton}" Padding="0" Margin="0"
                        ToolTip="Fold every list down to its header" Click="CollapseAll_Click"/>
            </UniformGrid>
            <TextBlock x:Name="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource InkSoft}"/>
        </StackPanel>
    </Grid>
</UserControl>
