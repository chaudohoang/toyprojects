<Window x:Class="CharlieTheSlave.AutomationBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charlie is working" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False">
    <Border CornerRadius="12" Background="#F2B3261E" BorderBrush="#FFFFD54F" BorderThickness="2"
            Padding="26,16" MaxWidth="900">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Headline" Foreground="White" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                       Text="✋  HANDS OFF — CHARLIE IS USING YOUR MOUSE AND KEYBOARD"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="Status" Foreground="#FFFFE082" FontSize="15" TextAlignment="Center"
                       Margin="0,10,0,0" TextWrapping="Wrap" Text="Starting…"/>
            <Border x:Name="HotkeyBox" Background="#33000000" CornerRadius="6" Padding="14,6" Margin="0,12,0,0"
                    HorizontalAlignment="Center">
                <TextBlock Foreground="White" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"
                           Text="Press  Ctrl + Alt + Q  to stop"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
