<!-- Dark palette: same values as the dark block of web\YdkeDeckBuilder\index.html. Keys must match Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#14161C" />
    <SolidColorBrush x:Key="PanelBg" Color="#1D2029" />
    <SolidColorBrush x:Key="Ink" Color="#E6E8EE" />
    <SolidColorBrush x:Key="Muted" Color="#9AA3B2" />
    <SolidColorBrush x:Key="Line" Color="#2E3340" />
    <SolidColorBrush x:Key="Accent" Color="#748FFC" />
    <!-- Dark text on the light-blue accent reads better than the page's white. -->
    <SolidColorBrush x:Key="OnAccent" Color="#0E1325" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#3D4352" />
    <SolidColorBrush x:Key="Err" Color="#FF8787" />
    <SolidColorBrush x:Key="Warn" Color="#FFD43B" />
    <SolidColorBrush x:Key="Info" Color="#748FFC" />
    <SolidColorBrush x:Key="Monster" Color="#E8A54A" />
    <SolidColorBrush x:Key="Spell" Color="#38D9A9" />
    <SolidColorBrush x:Key="Trap" Color="#F783AC" />
    <SolidColorBrush x:Key="Extra" Color="#B197FC" />
</ResourceDictionary>
