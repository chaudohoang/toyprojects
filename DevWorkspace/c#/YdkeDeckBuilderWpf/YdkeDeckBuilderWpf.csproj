<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YdkeDeckBuilderWpf</AssemblyName>
    <RootNamespace>YdkeDeckBuilderWpf</RootNamespace>
    <ApplicationIcon>..\YdkeDeckBuilder\app.ico</ApplicationIcon>
    <Product>YDKE Deck Builder</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Native WPF port of web\YdkeDeckBuilder\index.html (no WebView2). dotnet publish makes one exe;
       framework-dependent by default. For a self-contained one pass -p:SelfContained=true
       -p:IncludeNativeLibrariesForSelfExtract=true (WPF's native DLLs would otherwise sit loose). -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\YdkeDeckBuilder\app.ico" Link="app.ico" />
    <!-- Card-art fingerprints for reading screenshots (CardRecognition.cs), built from YGOPRODeck's images. The
         app tops it up with new cards itself; regenerate it only to shrink that first download. -->
    <Resource Include="art-index.bin" />
  </ItemGroup>

</Project>
