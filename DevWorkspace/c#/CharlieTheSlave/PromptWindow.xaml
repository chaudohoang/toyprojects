<Window x:Class="CharlieTheSlave.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charlie The Slave" Width="440" Height="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="12" Background="#FF1E1F26" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" Background="Transparent"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24" Click="Hide_Click"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="✦ Charlie The Slave" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Messages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="9,6" CornerRadius="8"
                                    Background="{Binding Background}" HorizontalAlignment="{Binding Align}">
                                <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" Foreground="#EEE"
                                         MaxWidth="340" FontSize="13" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         SelectionBrush="#7C5CFF"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBox x:Name="Input" KeyDown="Input_KeyDown" PreviewKeyDown="Input_PreviewKeyDown"
                         TextChanged="Input_TextChanged"
                         Background="#2A2C36" Foreground="White" CaretBrush="White"
                         BorderThickness="0" Padding="8,7" FontSize="13"/>
                <TextBlock x:Name="Placeholder" Text="Type a command… e.g. update TrueTest"
                           Foreground="#777" Margin="11,7,0,0" FontSize="13" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
