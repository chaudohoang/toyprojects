<Window x:Class="CharlieTheSlave.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charlie The Slave" Width="44" Height="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open prompt" Click="Open_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Cursor="Hand" ToolTip="Click to ask · drag to move · right-click for menu">
        <!-- 44 px window, 36 px circle: fits inside the Windows 11 taskbar (48 px). -->
        <Ellipse Margin="4">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C5CFF" Offset="0"/>
                    <GradientStop Color="#22B8CF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="✦" FontSize="18" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
        <Ellipse x:Name="BusyRing" Margin="1" Stroke="#FFD43B" StrokeThickness="2.5"
                 StrokeDashArray="3 2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="BusyRotation"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
