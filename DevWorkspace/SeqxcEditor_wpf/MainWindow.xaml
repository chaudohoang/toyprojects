<Window x:Class="SeqxcEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SeqxcEditor"
        Title="SeqXC Editor" Height="700" Width="1100"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        KeyDown="Window_KeyDown">

    <DockPanel>

        <!-- ── TOOLBAR ───────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#F2F2F2" BorderBrush="#DEDEDE" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="4,3">

                <Button x:Name="btnOpen"    Content="📂 Open"       Foreground="#0064C8"  Style="{StaticResource FlatBtn}" Click="BtnOpen_Click"    ToolTip="Open .seqxc file (Ctrl+O)"/>
                <Button x:Name="btnSave"    Content="💾 Save"        Foreground="#008237"  Style="{StaticResource FlatBtn}" Click="BtnSave_Click"    ToolTip="Save (Ctrl+S)" IsEnabled="False"/>
                <Button x:Name="btnSaveAs"  Content="Save As…"       Foreground="#A05A00"  Style="{StaticResource FlatBtn}" Click="BtnSaveAs_Click"  IsEnabled="False"/>

                <Separator Margin="4,2" Background="#D0D0D0"/>

                <Button x:Name="btnAll"     Content="All"            Foreground="#555555"  Style="{StaticResource FlatBtn}" Click="BtnAll_Click"/>
                <Button x:Name="btnNone"    Content="None"           Foreground="#555555"  Style="{StaticResource FlatBtn}" Click="BtnNone_Click"/>

                <Separator Margin="4,2" Background="#D0D0D0"/>

                <Button x:Name="btnClone"   Content="Clone (0)"      Foreground="#006EA0"  Style="{StaticResource FlatBtn}" Click="BtnClone_Click"   IsEnabled="False"/>
                <Button x:Name="btnDelete"  Content="Delete (0)"     Foreground="#B40000"  Style="{StaticResource FlatBtn}" Click="BtnDelete_Click"  IsEnabled="False"/>

                <Separator Margin="4,2" Background="#D0D0D0"/>

                <Button x:Name="btnPaste"   Content="Paste (0) → 0 steps" Foreground="#640096" Style="{StaticResource FlatBtn}" Click="BtnPaste_Click" IsEnabled="False"/>
                <Button x:Name="btnClearClip" Content="✕ Clip"       Foreground="#888888"  Style="{StaticResource FlatBtn}" Click="BtnClearClip_Click" IsEnabled="False"/>
                <Button x:Name="btnCopyList" Content="Copy list (0) ▼" Foreground="#888888" Style="{StaticResource FlatBtn}" Click="BtnCopyList_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="copyListMenu"/>
                    </Button.ContextMenu>
                </Button>

                <Separator Margin="4,2" Background="#D0D0D0"/>
                <TextBlock x:Name="lblClipInfo" VerticalAlignment="Center" Foreground="#777777" FontSize="11" Margin="4,0"/>
            </WrapPanel>
        </Border>

        <!-- ── STATUS BAR ────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#F8F8F8" BorderBrush="#DEDEDE" BorderThickness="0,1,0,0" Height="24">
            <TextBlock x:Name="lblStatus" VerticalAlignment="Center" Margin="8,0"
                       Text="Ready  —  open a .seqxc file  (Ctrl+O or drag &amp; drop)"
                       FontSize="11" Foreground="#555555"/>
        </Border>

        <!-- ── MAIN CONTENT ───────────────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Step list ─────────────────────────────────────────── -->
            <DockPanel Grid.Column="0" Background="White">

                <!-- Header -->
                <Border DockPanel.Dock="Top" Height="34" Background="#E6E9EE">
                    <DockPanel Margin="8,0">
                        <TextBlock Text="SEQUENCE STEPS" FontWeight="Bold" FontSize="11"
                                   Foreground="#464646" VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnMvUp"   Content="▲" Style="{StaticResource IconBtn}"
                                    Click="BtnMvUp_Click"   Margin="0,0,2,0" ToolTip="Move step up"/>
                            <Button x:Name="btnMvDown" Content="▼" Style="{StaticResource IconBtn}"
                                    Click="BtnMvDown_Click" Margin="0,0,8,0" ToolTip="Move step down"/>
                            <TextBlock x:Name="lblCheckedCount" Text="0 checked"
                                       FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Step DataGrid -->
                <DataGrid x:Name="dgSteps"
                          HeadersVisibility="None"
                          CanUserResizeRows="False"
                          PreviewMouseRightButtonUp="DgSteps_RightClick"
                          SelectionChanged="DgSteps_SelectionChanged">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#C6DAF7"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
                                </MultiDataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEF4FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <!-- Checkbox -->
                        <DataGridCheckBoxColumn
                            Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="28" CanUserResize="False"/>

                        <!-- Step name -->
                        <DataGridTextColumn
                            Binding="{Binding DisplayName}"
                            Width="150" MinWidth="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Analysis type badge -->
                        <DataGridTemplateColumn Width="*" MinWidth="60" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="BadgeBorder" CornerRadius="3"
                                            Padding="5,1" Margin="2,2" HorizontalAlignment="Left">
                                        <TextBlock x:Name="BadgeText"
                                                   Text="{Binding TypeLabel}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Badge}" Value="REG">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#E8F8EE"/>
                                            <Setter TargetName="BadgeText"   Property="Foreground" Value="#007A3D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Badge}" Value="POCB">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#E4EDFF"/>
                                            <Setter TargetName="BadgeText"   Property="Foreground" Value="#0050B4"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Badge}" Value="MEAS">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FFF3E0"/>
                                            <Setter TargetName="BadgeText"   Property="Foreground" Value="#8B4F00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="BadgeText"   Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ── SPLITTER ────────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- ── RIGHT: Detail panel ─────────────────────────────────────── -->
            <DockPanel Grid.Column="2">

                <!-- Step info -->
                <Border DockPanel.Dock="Top" Background="#F8FAFD"
                        BorderBrush="#E0E4EC" BorderThickness="0,0,0,1"
                        Padding="12,6,12,6" MinHeight="64">
                    <StackPanel>
                        <TextBlock x:Name="lblShared" FontSize="11" Foreground="#A05A00"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="lblStepName" FontSize="15" FontWeight="Bold"
                                   Foreground="#14183C" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="lblEnabled" FontSize="11" Margin="0,0,14,0"/>
                            <TextBlock x:Name="lblStepIdx" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tab buttons -->
                <Border DockPanel.Dock="Top" Background="#F0F2F5"
                        BorderBrush="#E0E4EC" BorderThickness="0,0,0,1" Height="34">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0">
                        <Button x:Name="btnTabAnalysis"  Content="Analysis"     Style="{StaticResource TabBtn}"
                                FontWeight="Bold" Foreground="#00468A" Background="White"
                                BorderBrush="#0064C8" Click="BtnTabAnalysis_Click"/>
                        <Button x:Name="btnTabPatSetup"  Content="PatternSetup" Style="{StaticResource TabBtn}"
                                Click="BtnTabPatSetup_Click"/>
                    </StackPanel>
                </Border>

                <!-- PropGrids (one visible at a time) -->
                <Grid>
                    <local:PropGrid x:Name="pgAnalysis"/>
                    <local:PropGrid x:Name="pgPat" Visibility="Collapsed"/>
                </Grid>

            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
