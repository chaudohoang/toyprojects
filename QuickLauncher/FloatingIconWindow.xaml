<Window x:Class="QuickLauncher.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Launcher" Width="60" Height="60"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" AllowDrop="True">
    <Window.ContextMenu>
        <ContextMenu Opened="Menu_Opened">
            <MenuItem x:Name="MenuToggle" Header="Show panel" Click="Toggle_Click" FontWeight="SemiBold"/>
            <MenuItem x:Name="MenuRecent" Header="Recent"/>
            <MenuItem Header="Rescan games and apps" Click="Rescan_Click"/>
            <MenuItem Header="Default position" Click="DefaultPosition_Click"
                      ToolTip="Move this icon back to the top of the screen"/>
            <Separator/>
            <MenuItem Header="Exit Quick Launcher" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Cursor="Hand"
          ToolTip="Click: show / hide · Drag: move · Drop an exe, a shortcut or a folder here to add it to the open tab · Right-click: menu">
        <Ellipse Margin="6" Fill="{StaticResource Brand}">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.45"/>
            </Ellipse.Effect>
        </Ellipse>
        <!-- Lightning bolt glyph (Segoe MDL2 / Fluent "LightningBolt"). -->
        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="BusyRing" Margin="2" Stroke="#FFD43B" StrokeThickness="3"
                 StrokeDashArray="3 2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="BusyRotation"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Popup x:Name="Toast" Placement="Top" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,6" MaxWidth="320">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Fg}" TextWrapping="Wrap"/>
            </Border>
        </Popup>
    </Grid>
</Window>
